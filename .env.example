# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Exact public address people open. Goes onto the NFC cards (<site>/k/<code>) and is the only
# origin allowed to save changes. Set it before writing real cards.
NUXT_PUBLIC_SITE_URL=https://staging.example.co.id

# Password of every seeded account (at least 10 characters; the app won't start with a shorter one,
# so this placeholder has to be replaced). Data is in memory: accounts go back to it on every restart.
NUXT_SEED_PASSWORD=ganti

# Demo buttons on the login page (they only work with the demo password). Off for anything public.
NUXT_PUBLIC_DEMO_LOGIN=false

# The host's Nginx is in front: use the address it appends to X-Forwarded-For.
NUXT_TRUST_PROXY=true
